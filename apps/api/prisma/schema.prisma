generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum AdminRole {
  OWNER
  MANAGER
  STAFF
}
enum PricingType {
  PER_NIGHT
  PER_BOOKING
}
enum AddOnPricingType {
  PER_BOOKING
  PER_NIGHT
  PER_GUEST
  PER_GUEST_PER_NIGHT
}
enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}
enum BookingStatus {
  HOLD
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
  EXPIRED
}
enum PaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
  FAILED
  REFUND_PENDING
  PARTIALLY_REFUNDED
  REFUNDED
}
enum PaymentOption {
  DEPOSIT
  FULL
}
enum BookingSource {
  DIRECT_WEBSITE
  ADMIN
  PHONE
  WALK_IN
  BOOKING_COM
  AIRBNB
  AGODA
  OTHER
}
enum PaymentProviderName {
  PAYHERE
  BANK_TRANSFER
  CASH
}
enum BookingPriceLineType {
  ROOM_RATE
  EXTRA_GUEST
  ADD_ON
  DISCOUNT
  TAX
  SERVICE_CHARGE
  ADJUSTMENT
}

model Property {
  id String @id @default(cuid())
  name String
  slug String @unique
  description String @db.Text
  address String?
  city String?
  district String?
  country String @default("Sri Lanka")
  timezone String @default("Asia/Colombo")
  currency String @default("LKR")
  phone String?
  email String?
  checkInTime String @default("14:00")
  checkOutTime String @default("11:00")
  taxPercentage Decimal @default(0) @db.Decimal(6,2)
  serviceChargePercentage Decimal @default(0) @db.Decimal(6,2)
  bankTransferInstructions String? @db.Text
  calendarFeedToken String @unique
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  units Unit[]
  packages Package[]
  addOns AddOn[]
  bookings Booking[]
}

model Unit {
  id String @id @default(cuid())
  propertyId String
  name String
  slug String
  description String? @db.Text
  unitType String @default("PRIVATE_VILLA")
  inventoryCount Int @default(1)
  bedrooms Int @default(4)
  bathrooms Int @default(4)
  baseOccupancy Int @default(2)
  maximumOccupancy Int @default(10)
  maximumAdults Int @default(10)
  maximumChildren Int @default(6)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  packages Package[]
  bookings Booking[]
  availabilityBlocks AvailabilityBlock[]
  amenities UnitAmenity[]
  @@unique([propertyId, slug])
  @@index([propertyId])
}

model Package {
  id String @id @default(cuid())
  propertyId String
  unitId String
  name String
  slug String
  shortDescription String
  fullDescription String @db.Text
  basePrice Decimal @db.Decimal(12,2)
  pricingType PricingType @default(PER_NIGHT)
  includedAdults Int @default(2)
  includedChildren Int @default(0)
  maximumGuests Int @default(10)
  minimumNights Int @default(1)
  maximumNights Int @default(30)
  depositPercentage Decimal @default(50) @db.Decimal(5,2)
  mealPlan String?
  cancellationPolicy String @db.Text
  terms String @db.Text
  featured Boolean @default(false)
  active Boolean @default(true)
  displayOrder Int @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  images PackageImage[]
  amenities PackageAmenity[]
  seasonalRates SeasonalRate[]
  dateOverrides DateRateOverride[]
  bookings Booking[]
  @@unique([propertyId, slug])
  @@index([unitId])
}

model PackageImage {
  id String @id @default(cuid())
  packageId String
  imageUrl String
  altText String
  displayOrder Int @default(0)
  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  @@index([packageId])
}
model Amenity {
  id String @id @default(cuid())
  name String @unique
  icon String?
  active Boolean @default(true)
  packages PackageAmenity[]
  units UnitAmenity[]
}
model PackageAmenity {
  packageId String
  amenityId String
  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  @@id([packageId, amenityId])
}
model UnitAmenity {
  unitId String
  amenityId String
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  amenity Amenity @relation(fields: [amenityId], references: [id], onDelete: Cascade)
  @@id([unitId, amenityId])
}

model SeasonalRate {
  id String @id @default(cuid())
  packageId String
  name String
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  nightlyPrice Decimal @db.Decimal(12,2)
  weekendPrice Decimal? @db.Decimal(12,2)
  minimumNights Int?
  priority Int @default(0)
  active Boolean @default(true)
  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  @@index([packageId, startDate, endDate, priority])
}

model DateRateOverride {
  id String @id @default(cuid())
  packageId String
  date DateTime @db.Date
  price Decimal? @db.Decimal(12,2)
  minimumNights Int?
  closed Boolean @default(false)
  closedToArrival Boolean @default(false)
  closedToDeparture Boolean @default(false)
  note String?
  package Package @relation(fields: [packageId], references: [id], onDelete: Cascade)
  @@unique([packageId, date])
}

model AddOn {
  id String @id @default(cuid())
  propertyId String
  name String
  description String?
  pricingType AddOnPricingType
  price Decimal @db.Decimal(12,2)
  maximumQuantity Int @default(1)
  active Boolean @default(true)
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  bookingAddOns BookingAddOn[]
}
model Coupon {
  id String @id @default(cuid())
  code String @unique
  description String?
  discountType DiscountType
  discountValue Decimal @db.Decimal(12,2)
  minimumBookingAmount Decimal? @db.Decimal(12,2)
  maximumDiscount Decimal? @db.Decimal(12,2)
  validFrom DateTime? @db.Date
  validUntil DateTime? @db.Date
  usageLimit Int?
  usageCount Int @default(0)
  active Boolean @default(true)
}
model Guest {
  id String @id @default(cuid())
  firstName String
  lastName String
  email String
  phone String
  country String?
  address String?
  identityDocumentReference String?
  marketingConsent Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  bookings Booking[]
  @@index([email])
  @@index([phone])
}

model Booking {
  id String @id @default(cuid())
  reference String @unique
  propertyId String
  unitId String
  packageId String
  guestId String
  checkInDate DateTime @db.Date
  checkOutDate DateTime @db.Date
  nights Int
  adults Int
  children Int @default(0)
  infants Int @default(0)
  subtotal Decimal @db.Decimal(12,2)
  addOnTotal Decimal @db.Decimal(12,2)
  discountTotal Decimal @db.Decimal(12,2)
  taxTotal Decimal @db.Decimal(12,2)
  serviceChargeTotal Decimal @db.Decimal(12,2)
  grandTotal Decimal @db.Decimal(12,2)
  depositRequired Decimal @db.Decimal(12,2)
  amountPaid Decimal @default(0) @db.Decimal(12,2)
  balanceDue Decimal @db.Decimal(12,2)
  currency String @default("LKR")
  bookingStatus BookingStatus @default(HOLD)
  paymentStatus PaymentStatus @default(UNPAID)
  paymentOption PaymentOption @default(DEPOSIT)
  source BookingSource @default(DIRECT_WEBSITE)
  specialRequests String? @db.Text
  internalNotes String? @db.Text
  cancellationReason String? @db.Text
  manageTokenHash String?
  expiresAt DateTime?
  confirmedAt DateTime?
  cancelledAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  property Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Restrict)
  package Package @relation(fields: [packageId], references: [id], onDelete: Restrict)
  guest Guest @relation(fields: [guestId], references: [id], onDelete: Restrict)
  addOns BookingAddOn[]
  priceLines BookingPriceLine[]
  payments Payment[]
  @@index([unitId, checkInDate, checkOutDate, bookingStatus])
  @@index([reference])
}

model BookingAddOn {
  id String @id @default(cuid())
  bookingId String
  addOnId String
  nameSnapshot String
  quantity Int
  unitPrice Decimal @db.Decimal(12,2)
  total Decimal @db.Decimal(12,2)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  addOn AddOn @relation(fields: [addOnId], references: [id], onDelete: Restrict)
}
model BookingPriceLine {
  id String @id @default(cuid())
  bookingId String
  type BookingPriceLineType
  description String
  serviceDate DateTime? @db.Date
  quantity Int
  unitAmount Decimal @db.Decimal(12,2)
  totalAmount Decimal @db.Decimal(12,2)
  metadata Json?
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
}
model Payment {
  id String @id @default(cuid())
  bookingId String
  provider PaymentProviderName
  providerPaymentId String?
  providerOrderId String?
  idempotencyKey String @unique
  amount Decimal @db.Decimal(12,2)
  currency String
  status PaymentStatus @default(UNPAID)
  paymentMethod String?
  rawStatusCode String?
  verified Boolean @default(false)
  failureReason String?
  processedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  events PaymentEvent[]
  @@index([providerOrderId])
}
model PaymentEvent {
  id String @id @default(cuid())
  paymentId String?
  provider PaymentProviderName
  eventType String
  externalEventId String?
  payloadHash String
  status String
  processedAt DateTime?
  createdAt DateTime @default(now())
  payment Payment? @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  @@unique([provider, externalEventId])
}
model AvailabilityBlock {
  id String @id @default(cuid())
  unitId String
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  reason String
  notes String? @db.Text
  createdById String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  unit Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdBy AdminUser? @relation(fields: [createdById], references: [id], onDelete: SetNull)
  @@index([unitId, startDate, endDate])
}
model AdminUser {
  id String @id @default(cuid())
  name String
  email String @unique
  passwordHash String
  role AdminRole @default(STAFF)
  active Boolean @default(true)
  lastLoginAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  blocks AvailabilityBlock[]
  auditLogs AuditLog[]
  sessions AdminSession[]
}
model AuditLog {
  id String @id @default(cuid())
  adminUserId String?
  action String
  entityType String
  entityId String?
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
  adminUser AdminUser? @relation(fields: [adminUserId], references: [id], onDelete: SetNull)
  @@index([entityType, entityId])
}
model NotificationLog {
  id String @id @default(cuid())
  bookingId String?
  recipient String
  template String
  status String
  providerMessageId String?
  errorMessage String?
  createdAt DateTime @default(now())
}
model AdminSession {
  id String @id @default(cuid())
  adminUserId String
  tokenHash String @unique
  ipAddress String?
  userAgent String? @db.Text
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  lastSeenAt DateTime @default(now())
  adminUser AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  @@index([adminUserId])
  @@index([expiresAt])
}
