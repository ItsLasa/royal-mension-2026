{
    "name":  "royal-mansion-resort",
    "version":  "0.1.0",
    "private":  true,
    "scripts":  {
                    "dev":  "concurrently \"npm run dev:web\" \"npm run dev:api\"",
                    "dev:web":  "next dev",
                    "dev:api":  "tsx apps/api/src/server.ts",
                    "build":  "npm run build:web \u0026\u0026 npm run build:api",
                    "build:web":  "next build",
                    "build:api":  "tsc -p apps/api/tsconfig.json",
                    "start":  "next start",
                    "start:api":  "node apps/api/dist/server.js",
                    "lint":  "next lint",
                    "typecheck":  "tsc --noEmit \u0026\u0026 tsc -p apps/api/tsconfig.json --noEmit",
                    "test":  "vitest run",
                    "test:unit":  "vitest run apps/api/tests/unit",
                    "test:integration":  "vitest run apps/api/tests/integration",
                    "test:e2e":  "playwright test",
                    "db:generate":  "prisma generate --schema apps/api/prisma/schema.prisma",
                    "db:migrate":  "prisma migrate dev --schema apps/api/prisma/schema.prisma",
                    "db:seed":  "tsx apps/api/prisma/seed.ts"
                },
    "dependencies":  {
                         "framer-motion":  "^12.42.2",
                         "gsap":  "^3.15.0",
                         "lenis":  "^1.3.25",
                         "next":  "^14.2.0",
                         "next-font":  "^2.0.2",
                         "react":  "^18.3.0",
                         "react-dom":  "^18.3.0",
                         "react-icons":  "^5.7.0",
                         "decimal.js":  "^10.6.0",
                         "helmet":  "^8.1.0",
                         "bcryptjs":  "^3.0.2",
                         "express-rate-limit":  "^8.0.1",
                         "express":  "^5.1.0",
                         "ical-generator":  "^9.0.0",
                         "cookie-parser":  "^1.4.7",
                         "zod":  "^4.0.5",
                         "@prisma/client":  "^6.13.0",
                         "cors":  "^2.8.5",
                         "pino-http":  "^10.5.0",
                         "nanoid":  "^5.1.5",
                         "date-fns":  "^4.1.0",
                         "pino":  "^9.7.0"
                     },
    "devDependencies":  {
                            "@types/node":  "^20.0.0",
                            "@types/react":  "^18.3.0",
                            "@types/react-dom":  "^18.3.0",
                            "autoprefixer":  "^10.4.0",
                            "eslint":  "^8.0.0",
                            "eslint-config-next":  "^14.2.0",
                            "postcss":  "^8.4.0",
                            "tailwindcss":  "^3.4.0",
                            "typescript":  "^5.4.0",
                            "prisma":  "^6.13.0",
                            "@types/bcryptjs":  "^2.4.6",
                            "supertest":  "^7.1.4",
                            "@types/cors":  "^2.8.19",
                            "@types/supertest":  "^6.0.3",
                            "concurrently":  "^9.2.0",
                            "@types/express":  "^5.0.3",
                            "vitest":  "^3.2.4",
                            "tsx":  "^4.20.3",
                            "@types/cookie-parser":  "^1.4.9"
                        }
}
