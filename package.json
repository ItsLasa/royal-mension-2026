{
    "name": "royal-mansion-resort",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
        "dev:web": "next dev",
        "dev:api": "tsx apps/api/src/server.ts",
        "build": "npm run build:web && npm run build:api",
        "build:web": "next build",
        "build:api": "tsc -p apps/api/tsconfig.json",
        "start": "next start",
        "start:api": "node apps/api/dist/server.js",
        "lint": "next lint",
        "typecheck": "tsc --noEmit && tsc -p apps/api/tsconfig.json --noEmit",
        "test": "vitest run",
        "test:unit": "vitest run apps/api/tests/unit",
        "test:integration": "vitest run apps/api/tests/integration",
        "test:e2e": "playwright test",
        "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
        "db:migrate": "prisma migrate dev --schema apps/api/prisma/schema.prisma",
        "db:seed": "tsx apps/api/prisma/seed.ts"
    },
    "dependencies": {
        "@prisma/client": "^6.13.0",
        "@tanstack/react-table": "^8.21.3",
        "bcryptjs": "^3.0.2",
        "clsx": "^2.1.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "date-fns": "^4.1.0",
        "decimal.js": "^10.6.0",
        "express": "^5.1.0",
        "express-rate-limit": "^8.0.1",
        "framer-motion": "^12.42.2",
        "gsap": "^3.15.0",
        "helmet": "^8.1.0",
        "ical-generator": "^9.0.0",
        "lenis": "^1.3.25",
        "nanoid": "^5.1.5",
        "next": "^14.2.0",
        "next-font": "^2.0.2",
        "pino": "^9.7.0",
        "pino-http": "^10.5.0",
        "react": "^18.3.0",
        "react-dom": "^18.3.0",
        "react-icons": "^5.7.0",
        "recharts": "^3.10.1",
        "sonner": "^2.0.7",
        "tailwind-merge": "^3.6.0",
        "zod": "^4.0.5"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cookie-parser": "^1.4.9",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/node": "^20.0.0",
        "@types/react": "^18.3.0",
        "@types/react-dom": "^18.3.0",
        "@types/supertest": "^6.0.3",
        "autoprefixer": "^10.4.0",
        "concurrently": "^9.2.0",
        "eslint": "^8.0.0",
        "eslint-config-next": "^14.2.0",
        "postcss": "^8.4.0",
        "prisma": "^6.13.0",
        "supertest": "^7.1.4",
        "tailwindcss": "^3.4.0",
        "tsx": "^4.20.3",
        "typescript": "^5.4.0",
        "vitest": "^3.2.4"
    }
}
